// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model App {
  id          String       @id @default(cuid())
  slug        String       @unique
  folderSlug  String       @unique
  name        String
  category    String
  description String
  status      String       @default("draft")
  priceCents  Int          @default(999)
  imageUrl    String?
  accentColor String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  relatedFrom RelatedApp[] @relation("RelatedFrom")
  relatedTo   RelatedApp[] @relation("RelatedTo")

  // Conteúdo do "app de verdade" (home, menu, plano, quiz etc.)
  tagline   String?
  heroBadge String?
  heroTitle String?

  // Diagnóstico — textos simples (perguntas/alertas/métricas são tabelas abaixo)
  diagnosticoBoaNoticia  String?
  diagnosticoPlanoTitulo String?
  diagnosticoPlanoTexto  String?

  ebookTitle    String?
  ebookSubtitle String?
  ebookPdfUrl   String?

  articles          Article[]
  podcasts          Podcast[]
  videoLessons      VideoLesson[]
  newsItems         NewsItem[]
  userProgress      UserProgress[]
  quizQuestions     QuizQuestion[]
  navItems          NavItem[]
  appLabels         AppLabel[]
  planWeeks         PlanWeek[]
  diagnosticQuestions DiagnosticQuestion[]
  diagnosticAlerts    DiagnosticAlert[]
  diagnosticMetrics   DiagnosticMetric[]
  progressPhraseRows  ProgressPhrase[]
  ebookFeatureRows    EbookFeature[]
}

model NavItem {
  id    String  @id @default(cuid())
  appId String
  app   App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  page  String
  icon  String?
  label String
  order Int     @default(0)
}

model AppLabel {
  id    String @id @default(cuid())
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  key   String
  value String

  @@unique([appId, key])
}

model PlanWeek {
  id       String    @id @default(cuid())
  appId    String
  app      App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  name     String
  subtitle String?
  order    Int       @default(0)
  days     PlanDay[]
}

model PlanDay {
  id        String         @id @default(cuid())
  weekId    String
  week      PlanWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  name      String
  order     Int            @default(0)
  exercises PlanExercise[]
}

model PlanExercise {
  id     String  @id @default(cuid())
  dayId  String
  day    PlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name   String
  reps   String?
  order  Int     @default(0)
  desc   String?
  steps  String[]
  tip    String?
  type   String?
  series Int?
  video  String?
}

model DiagnosticQuestion {
  id     String             @id @default(cuid())
  appId  String
  app    App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  titulo String
  order  Int                @default(0)
  opcoes DiagnosticOption[]
}

model DiagnosticOption {
  id         String             @id @default(cuid())
  questionId String
  question   DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  texto      String
  descricao  String?
  valor      Int?
  order      Int                @default(0)
}

model DiagnosticAlert {
  id    String @id @default(cuid())
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  text  String
  order Int    @default(0)
}

model DiagnosticMetric {
  id    String @id @default(cuid())
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  n     String
  de    String
  para  String
  order Int    @default(0)
}

model ProgressPhrase {
  id    String @id @default(cuid())
  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  text  String
  order Int    @default(0)
}

model EbookFeature {
  id    String  @id @default(cuid())
  appId String
  app   App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  icon  String?
  text  String
  order Int     @default(0)
}

model QuizQuestion {
  id          String   @id @default(cuid())
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  category    String?
  difficulty  String?
  question    String
  options     String[]
  correct     Int
  explanation String?
  order       Int      @default(0)
}

model Article {
  id       String @id @default(cuid())
  appId    String
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  icon     String?
  title    String
  cardDesc String?
  subtitle String?
  content  String
  order    Int    @default(0)
}

model Podcast {
  id       String  @id @default(cuid())
  appId    String
  app      App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  title    String
  duration String?
  url      String
  free     Boolean @default(true)
  order    Int     @default(0)
}

model VideoLesson {
  id      String  @id @default(cuid())
  appId   String
  app     App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  videoId String
  title   String
  num     String?
  order   Int     @default(0)
}

model NewsItem {
  id     String  @id @default(cuid())
  appId  String
  app    App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  title  String
  source String?
  url    String
  thumb  String?
  date   String?
  order  Int     @default(0)
}

model UserProgress {
  id          String   @id @default(cuid())
  email       String
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  kind        String // "exercise" | "quiz"
  key         String // nome do exercício, ou "latest" pro quiz
  value       Json?
  completedAt DateTime @default(now())

  @@unique([email, appId, kind, key])
  @@index([email, appId])
}

model RelatedApp {
  id              String   @id @default(cuid())
  appId           String
  app             App      @relation("RelatedFrom", fields: [appId], references: [id], onDelete: Cascade)
  relatedAppId    String
  relatedApp      App      @relation("RelatedTo", fields: [relatedAppId], references: [id], onDelete: Cascade)
  comboPriceCents Int
  createdAt       DateTime @default(now())

  @@unique([appId, relatedAppId])
}

model Purchase {
  id              String   @id @default(cuid())
  email           String
  type            String // "app" | "combo"
  appIds          String[]
  amountCents     Int
  stripeSessionId String   @unique
  status          String   @default("pending") // "pending" | "paid"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}
