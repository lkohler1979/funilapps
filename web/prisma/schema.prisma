// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model App {
  id          String       @id @default(cuid())
  slug        String       @unique
  folderSlug  String       @unique
  name        String
  category    String
  description String
  status      String       @default("draft")
  priceCents  Int          @default(999)
  imageUrl    String?
  accentColor String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  relatedFrom RelatedApp[] @relation("RelatedFrom")
  relatedTo   RelatedApp[] @relation("RelatedTo")

  // Conteúdo do "app de verdade" (home, menu, plano, quiz etc.)
  tagline         String?
  heroBadge       String?
  heroTitle       String?
  navigation      Json?
  labels          Json?
  theme           Json?
  weeklyPlan      Json?
  quiz            Json?
  diagnostico     Json?
  news            Json?
  progressPhrases Json?
  ebookTitle      String?
  ebookSubtitle   String?
  ebookPdfUrl     String?
  ebookFeatures   Json?

  articles     Article[]
  podcasts     Podcast[]
  videoLessons VideoLesson[]
}

model Article {
  id       String @id @default(cuid())
  appId    String
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  icon     String?
  title    String
  cardDesc String?
  subtitle String?
  content  String
  order    Int    @default(0)
}

model Podcast {
  id       String  @id @default(cuid())
  appId    String
  app      App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  title    String
  duration String?
  url      String
  free     Boolean @default(true)
  order    Int     @default(0)
}

model VideoLesson {
  id      String  @id @default(cuid())
  appId   String
  app     App     @relation(fields: [appId], references: [id], onDelete: Cascade)
  videoId String
  title   String
  num     String?
  order   Int     @default(0)
}

model RelatedApp {
  id              String   @id @default(cuid())
  appId           String
  app             App      @relation("RelatedFrom", fields: [appId], references: [id], onDelete: Cascade)
  relatedAppId    String
  relatedApp      App      @relation("RelatedTo", fields: [relatedAppId], references: [id], onDelete: Cascade)
  comboPriceCents Int
  createdAt       DateTime @default(now())

  @@unique([appId, relatedAppId])
}

model Purchase {
  id              String   @id @default(cuid())
  email           String
  type            String // "app" | "combo"
  appIds          String[]
  amountCents     Int
  stripeSessionId String   @unique
  status          String   @default("pending") // "pending" | "paid"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}
